# Run from the project root: uv run --env-file .env app_svc.py --fp16 False
HF_HOME=./checkpoints
PYTORCH_ENABLE_MPS_FALLBACK=1
GRADIO_ANALYTICS_ENABLED=False
# Uncomment only if huggingface.co is unreachable:
# HF_ENDPOINT=https://hf-mirror.com
# A mirror may redirect to huggingface.co. If direct access fails, configure
# your local HTTP proxy too (replace the port with your proxy application's port).
# HTTP_PROXY=http://127.0.0.1:10808
# HTTPS_PROXY=http://127.0.0.1:10808
# NO_PROXY=localhost,127.0.0.1,::1
